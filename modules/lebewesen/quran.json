{
 "insan": {
  "s": 95,
  "a": 4,
  "text": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمࣲ",
  "start": true,
  "end": true
 },
 "adam": {
  "s": 2,
  "a": 31,
  "text": "وَعَلَّمَ ءَادَمَ ٱلۡأَسۡمَآءَ كُلَّهَا",
  "start": true,
  "end": false
 },
 "muhammad": {
  "s": 48,
  "a": 29,
  "text": "مُّحَمَّدࣱ رَّسُولُ ٱللَّهِۚ",
  "start": true,
  "end": false
 },
 "maryam": {
  "s": 19,
  "a": 16,
  "text": "وَٱذۡكُرۡ فِي ٱلۡكِتَٰبِ مَرۡيَمَ",
  "start": true,
  "end": false
 },
 "fil": {
  "s": 105,
  "a": 1,
  "text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",
  "start": true,
  "end": true
 },
 "kalb1": {
  "s": 18,
  "a": 18,
  "text": "وَكَلۡبُهُم بَٰسِطࣱ ذِرَاعَيۡهِ بِٱلۡوَصِيدِۚ",
  "start": false,
  "end": false
 },
 "kalb2": {
  "s": 7,
  "a": 176,
  "text": "فَمَثَلُهُۥ كَمَثَلِ ٱلۡكَلۡبِ",
  "start": false,
  "end": false
 },
 "nakhla": {
  "s": 19,
  "a": 25,
  "text": "وَهُزِّيٓ إِلَيۡكِ بِجِذۡعِ ٱلنَّخۡلَةِ تُسَٰقِطۡ عَلَيۡكِ رُطَبࣰا جَنِيࣰّا",
  "start": true,
  "end": true
 },
 "shajara": {
  "s": 14,
  "a": 24,
  "text": "ضَرَبَ ٱللَّهُ مَثَلࣰا كَلِمَةࣰ طَيِّبَةࣰ كَشَجَرَةࣲ طَيِّبَةٍ",
  "start": false,
  "end": false
 },
 "warda": {
  "s": 55,
  "a": 37,
  "text": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةࣰ كَٱلدِّهَانِ",
  "start": true,
  "end": true
 },
 "nahl": {
  "s": 16,
  "a": 68,
  "text": "وَأَوۡحَىٰ رَبُّكَ إِلَى ٱلنَّحۡلِ",
  "start": true,
  "end": false
 },
 "naml": {
  "s": 27,
  "a": 18,
  "text": "حَتَّىٰٓ إِذَآ أَتَوۡاْ عَلَىٰ وَادِ ٱلنَّمۡلِ قَالَتۡ نَمۡلَةࣱ",
  "start": true,
  "end": false
 },
 "ankabut": {
  "s": 29,
  "a": 41,
  "text": "كَمَثَلِ ٱلۡعَنكَبُوتِ ٱتَّخَذَتۡ بَيۡتࣰاۖ",
  "start": false,
  "end": false
 },
 "jarad": {
  "s": 7,
  "a": 133,
  "text": "فَأَرۡسَلۡنَا عَلَيۡهِمُ ٱلطُّوفَانَ وَٱلۡجَرَادَ وَٱلۡقُمَّلَ وَٱلضَّفَادِعَ وَٱلدَّمَ",
  "start": true,
  "end": false
 },
 "surur": {
  "s": 88,
  "a": 13,
  "text": "فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ",
  "start": true,
  "end": true
 },
 "bab": {
  "s": 2,
  "a": 58,
  "text": "وَٱدۡخُلُواْ ٱلۡبَابَ سُجَّدࣰا",
  "start": false,
  "end": false
 },
 "kursi": {
  "s": 2,
  "a": 255,
  "text": "وَسِعَ كُرۡسِيُّهُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَۖ",
  "start": false,
  "end": false
 },
 "maa": {
  "s": 21,
  "a": 30,
  "text": "وَجَعَلۡنَا مِنَ ٱلۡمَآءِ كُلَّ شَيۡءٍ حَيٍّۚ",
  "start": false,
  "end": false
 },
 "laban": {
  "s": 47,
  "a": 15,
  "text": "أَنۡهَٰرࣱ مِّن مَّآءٍ غَيۡرِ ءَاسِنࣲ وَأَنۡهَٰرࣱ مِّن لَّبَنࣲ لَّمۡ يَتَغَيَّرۡ طَعۡمُهُۥ",
  "start": false,
  "end": false
 },
 "asal": {
  "s": 47,
  "a": 15,
  "text": "وَأَنۡهَٰرࣱ مِّنۡ عَسَلࣲ مُّصَفࣰّىۖ",
  "start": false,
  "end": false
 }
}